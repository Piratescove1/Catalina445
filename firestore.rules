rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each boat's data. The payload is end-to-end encrypted on the device, so
    // the server never sees readable data. We block LISTING the collection so
    // nobody can enumerate or discover boats — a document can only be reached
    // by its exact boat code.
    match /boats/{boatId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if true;

      // Automatic encrypted history snapshots, scoped under a known boat.
      match /history/{snapId} {
        allow read, write: if true;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each boat's data. The payload is end-to-end encrypted on the device, so
    // the server never sees readable data. We block LISTING the collection so
    // nobody can enumerate or discover boats — a document can only be reached
    // by its exact boat code.
    match /boats/{boatId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if true;

      // Automatic encrypted history snapshots, scoped under a known boat.
      match /history/{snapId} {
        allow read, write: if true;
      }

      // Maintenance receipt files (one doc per receipt, ≤1 MB). Reachable only
      // via the exact boat code + receipt id; listing stays blocked.
      match /receipts/{receiptId} {
        allow get: if true;
        allow list: if false;
        allow create, update, delete: if true;
      }
    }

    // Cloud login / recovery: each signed-in user can read/write only their own
    // record (holds their boat id + password-wrapped key escrow).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
